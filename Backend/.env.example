# MongoDB connection string (Atlas or local)
MONGO_URI=

# Secret used to sign/verify JWTs
JWT_SECRET=

# Paystack secret key from your dashboard -> Settings -> API Keys & Webhooks.
# Use a TEST key (sk_test_...) for development. NEVER commit a real key.
PAYSTACK_SECRET_KEY=

# The frontend's dev origin (CORS + Paystack redirect target)
FRONTEND_URL=http://localhost:5180
