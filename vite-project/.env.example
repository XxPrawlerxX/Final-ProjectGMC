# Copy this file to .env and fill in the values. NEVER commit .env.

# MongoDB connection string (Atlas, or local: mongodb://127.0.0.1:27017/marketfind)
MONGODB_URI=

# Paystack TEST secret key from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=

PORT=8787
# The address the website is served from (used for CORS and CSRF checks)
CLIENT_ORIGIN=http://localhost:5173
# Delivery fee in naira
DELIVERY_FEE=2500
# Set to 1 when the server is behind a proxy/load balancer (Render, Railway, Nginx...)
TRUST_PROXY=0
# Set to production when deployed (turns on Secure cookies)
NODE_ENV=development

# --- Email (optional in development) ---
# Chat replies are emailed to the buyer. Without these the chat still works and the
# email is only printed in the server log. Use any SMTP service (Brevo, Mailgun,
# Gmail with an app password...). Port 587 or 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Marketfind <no-reply@yourdomain.com>

# Only if the website and API are on different domains (links to uploaded pictures)
PUBLIC_API_URL=
